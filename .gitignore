# Scraped order/device exports -- real customer and order data, never
# committed regardless of the exact filename a browser download gives it
# (e.g. "amazon-orders (5).json", not just "amazon-orders.json").
amazon-orders*.json
grover-devices*.json

# Personio employee directory export -- real names/emails/IDs for the team.
extraction_scripts/personio-employees.json
extraction_scripts/personio-employees.sql

# Cloudflare (OpenNext adapter) -- build output and local wrangler state.
# .dev.vars holds real secrets locally (Supabase URL/key), never commit it.
/.open-next/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
